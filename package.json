{
  "name": "amsl-broker",
  "private": true,
  "version": "1.0.0",
  "description": "AMSL Broker full-stack app \u2014 Express+SQLite API and React (Vite) UI.",
  "workspaces": [
    "amsl-backend",
    "amsl-frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace amsl-backend run dev",
    "dev:web": "npm --workspace amsl-frontend run dev",
    "build": "npm --workspace amsl-frontend run build",
    "start": "npm run build && npm --workspace amsl-backend start",
    "seed": "npm --workspace amsl-backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
