+/**
+ * Site-list converter.
+ *
+ * People rarely send the supplier's template. They send whatever they have: a portfolio
+ * summary with a title block above the table, "Supply Number" instead of "MPAN Core", one
+ * "Meter Number" column holding both MPANs and MPRNs, a full 21-digit MPAN in one cell,
+ * "Annual Consumption" instead of EAC_DAY, separate Electricity and Gas tabs, the current
+ * contract end date rather than a preferred start date, and so on.
+ *
+ * This module reads any such workbook (or CSV) and turns it into rows in the template's
+ * shape, together with a report of how each column was mapped and every assumption made,
+ * so the person can see what happened and correct the source if a guess was wrong. It can
+ * also write those rows back into the real template file for download.
+ */
+import ExcelJS from "exceljs";
+import JSZip from "jszip";
+
+/* ------------------------------------------------------------------ cell helpers */
+
+export const cellText = (v) => {
+  if (v == null) return "";
+  if (v instanceof Date) return v.toISOString().slice(0, 10);
+  if (typeof v === "object") {
+    if (v.error) return "";
+    if (v.text != null) return String(v.text).trim();
+    if (v.result != null) return cellText(v.result);
+    if (Array.isArray(v.richText)) return v.richText.map((t) => t.text).join("").trim();
+    return "";
+  }
+  if (typeof v === "number") {
+    // Avoid "1.23e+20" for long meter numbers typed into a number-formatted column.
+    return Number.isInteger(v) ? v.toLocaleString("fullwide", { useGrouping: false }) : String(v);
+  }
+  return String(v).trim();
+};
+const raw = (v) => (v && typeof v === "object" && !(v instanceof Date) && "result" in v ? v.result : v);
+
+const numOrNull = (v) => {
+  v = raw(v);
+  if (typeof v === "number") return Number.isFinite(v) ? v : null;
+  const s = cellText(v).replace(/[,£\s]/g, "").replace(/kwh|kw|units?|p\/?kwh/gi, "");
+  if (s === "" || s === "-") return null;
+  const n = Number(s);
+  return Number.isFinite(n) ? n : null;
+};
+const digits = (v) => cellText(raw(v)).replace(/\D/g, "");
+
+/** Excel serials, dd/mm/yy(yy), yyyy-mm-dd, "1 Oct 2026", Date objects → ISO date. */
+export function toIso(v) {
+  v = raw(v);
+  if (v instanceof Date) return Number.isNaN(v.getTime()) ? null : v.toISOString().slice(0, 10);
+  if (typeof v === "number") {
+    if (v > 20000 && v < 80000) {                 // Excel serial day number (1954–2119)
+      const d = new Date(Date.UTC(1899, 11, 30) + Math.round(v) * 86400000);
+      return d.toISOString().slice(0, 10);
+    }
+    return null;
+  }
+  const s = cellText(v);
+  if (!s) return null;
+  let m = s.match(/^(\d{1,2})[/.-](\d{1,2})[/.-](\d{2}|\d{4})$/);
+  if (m) {
+    const y = m[3].length === 2 ? `20${m[3]}` : m[3];
+    const dd = +m[1], mm = +m[2];
+    if (mm < 1 || mm > 12 || dd < 1 || dd > 31) return null;
+    return `${y}-${String(mm).padStart(2, "0")}-${String(dd).padStart(2, "0")}`;
+  }
+  m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
+  if (m) return `${m[1]}-${m[2]}-${m[3]}`;
+  if (/^\d+$/.test(s)) return toIso(Number(s));
+  const d = new Date(`${s} UTC`);
+  if (!Number.isNaN(d.getTime())) return d.toISOString().slice(0, 10);
+  const d2 = new Date(s);
+  return Number.isNaN(d2.getTime()) ? null : new Date(Date.UTC(d2.getFullYear(), d2.getMonth(), d2.getDate())).toISOString().slice(0, 10);
+}
+const addDays = (iso, n) => {
+  const d = new Date(`${iso}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+};
+
+const POSTCODE_RE = /\b(GIR ?0AA|[A-PR-UWYZ][A-HK-Y]?\d[A-Z\d]?) ?(\d[ABD-HJLNP-UW-Z]{2})\b/i;
+const findPostcode = (s) => {
+  const m = String(s || "").toUpperCase().match(POSTCODE_RE);
+  return m ? `${m[1]} ${m[2]}` : "";
+};
+const normPostcode = (s) => findPostcode(s) || cellText(s).toUpperCase();
+
+/* ------------------------------------------------------------------ reading */
+
+/** Remove comments/VML parts, which make the xlsx reader throw on some templates. */
+async function stripComments(buf) {
+  const zip = await JSZip.loadAsync(buf);
+  const isComment = (f) => /comments?\d*\.xml$/i.test(f) || /\.vml$/i.test(f) || /vmlDrawing/i.test(f) || /threadedComment/i.test(f);
+  const dead = Object.keys(zip.files).filter(isComment);
+  if (!dead.length) return buf;
+  dead.forEach((f) => zip.remove(f));
+  for (const name of Object.keys(zip.files)) {
+    if (/_rels\/.*\.rels$/i.test(name)) {
+      let xml = await zip.file(name).async("string");
+      xml = xml.replace(/<Relationship\b[^>]*\/>/gi, (tag) => (/comment|vml/i.test(tag) ? "" : tag));
+      zip.file(name, xml);
+    } else if (/^xl\/worksheets\/sheet\d+\.xml$/i.test(name)) {
+      let xml = await zip.file(name).async("string");
+      zip.file(name, xml.replace(/<legacyDrawing[^>]*\/>/gi, ""));
+    } else if (/^\[Content_Types\]\.xml$/i.test(name)) {
+      let xml = await zip.file(name).async("string");
+      xml = xml.replace(/<Override\b[^>]*\/>/gi, (tag) => (/comment/i.test(tag) ? "" : tag))
+               .replace(/<Default\b[^>]*Extension="vml"[^>]*\/>/gi, "");
+      zip.file(name, xml);
+    }
+  }
+  return zip.generateAsync({ type: "nodebuffer" });
+}
+
+/** RFC-4180-ish CSV: quoted fields, embedded commas/quotes/newlines, ; or tab delimiters. */
+function parseCsv(text) {
+  text = text.replace(/^﻿/, "");
+  const first = text.split(/\r?\n/, 1)[0] || "";
+  const count = (ch) => (first.match(new RegExp(`\\${ch}`, "g")) || []).length;
+  const delim = [",", ";", "\t"].sort((a, b) => count(b) - count(a))[0];
+  const rows = []; let row = [], cur = "", q = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (q) {
+      if (c === '"' && text[i + 1] === '"') { cur += '"'; i++; }
+      else if (c === '"') q = false;
+      else cur += c;
+    } else if (c === '"') q = true;
+    else if (c === delim) { row.push(cur); cur = ""; }
+    else if (c === "\n" || c === "\r") {
+      if (c === "\r" && text[i + 1] === "\n") i++;
+      row.push(cur); rows.push(row); row = []; cur = "";
+    } else cur += c;
+  }
+  if (cur !== "" || row.length) { row.push(cur); rows.push(row); }
+  return rows.map((r) => r.map((x) => x.trim()));
+}
+
+/** Any upload → [{ name, rows: value[][] }], one entry per non-empty sheet. */
+export async function readGrids(buf, filename = "") {
+  const isZip = buf.subarray(0, 2).toString() === "PK";
+  const isOle = buf.subarray(0, 4).toString("hex") === "d0cf11e0";
+  if (isOle || (/\.xls$/i.test(filename) && !isZip)) {
+    throw new Error("This is an old-style .xls file. Open it in Excel and use Save As → Excel Workbook (.xlsx), then upload that.");
+  }
+  if (!isZip) return [{ name: filename || "CSV", rows: parseCsv(buf.toString("utf8")) }];
+
+  const wb = new ExcelJS.Workbook();
+  try { await wb.xlsx.load(buf); }
+  catch { await wb.xlsx.load(await stripComments(buf)); }
+
+  const out = [];
+  for (const ws of wb.worksheets) {
+    if (ws.state && ws.state !== "visible") continue;          // hidden lookup tabs
+    const rows = [];
+    ws.eachRow({ includeEmpty: true }, (row, r) => {
+      const vals = [];
+      row.eachCell({ includeEmpty: true }, (cell, c) => {
+        // Merged cells: ExcelJS reports the master's value on each member cell, which is
+        // what we want for a merged group heading like "Electricity" over two columns.
+        vals[c - 1] = cell.value;
+      });
+      rows[r - 1] = vals;
+    });
+    for (let i = 0; i < rows.length; i++) if (!rows[i]) rows[i] = [];
+    if (rows.some((r) => r.some((v) => cellText(v)))) out.push({ name: ws.name, rows });
+  }
+  return out;
+}
+
+/* ------------------------------------------------------------------ header recognition */
+
+const norm = (s) => cellText(s).toLowerCase().replace(/&/g, " and ").replace(/[^a-z0-9]+/g, " ").trim();
+
+/**
+ * Header rules, most specific first. A column is claimed by the first rule it matches, and
+ * each field takes the first column that matches it, so "Day EAC" goes to eac_day before
+ * the generic "EAC" rule can take it. `not` excludes look-alikes (a meter SERIAL number is
+ * not an MPAN; a "site contact" is not a site).
+ */
+const RULES = [
+  // Dates first: "contract end date" must not be read as anything else.
+  { key: "start_date", re: /\b(pref+er+ed|requested|new|proposed|desired|required)\b.*\bstart\b|\bstart\b.*\b(pref+er+ed|requested)\b/ },
+  { key: "end_date", re: /\b(pref+er+ed|requested|new|proposed|desired|required)\b.*\bend\b|\bend\b.*\b(pref+er+ed|requested)\b/ },
+  { key: "current_end", re: /\b(contract end|current end|end date|ced|expiry|expires|renewal date|contract expiry|end of contract|cont end|termination date)\b/ },
+  { key: "current_start", re: /\b(contract start|start date|live date|go live|supply start|csd)\b/ },
+
+  { key: "crn", re: /^crn$|company (reg|registration|no|number)|registration (no|number)|co reg|companies house/ },
+  { key: "postcode", re: /\bpost ?code\b|\bpostal code\b|\bzip\b|\bpcode\b/, not: /profile/ },
+
+  // Meter identifiers
+  { key: "mpan_full", re: /full mpan|mpan full|21 digit|supply number full|full supply/ },
+  { key: "mpan_top", re: /top ?line|mpan top|supplementary|mpan supp/ },
+  { key: "profile_class", re: /^pc$|profile class|^profile$/ },
+  { key: "mtc", re: /^mtc$|meter time ?switch/ },
+  { key: "llf", re: /^llf|^llfc|line loss/ },
+  // A single column holding both kinds ("Meter Point (MPAN/MPRN)", "MPXN") is split per row.
+  { key: "meter_id", re: /\bmpxn\b|mpan (or |and )?mprn|mprn (or |and )?mpan|\bmpan mprn\b/ },
+  { key: "mprn", re: /\bmprn\b|meter point reference|gas meter point|gas supply point|\bm number\b|gas mpr\b|gas meter number|gas meter ref/, not: /serial|msn/ },
+  { key: "mpan_core", re: /\bmpan\b|supply number|\bs number\b|meter point admin|elec(tricity)? meter (point|number|ref)|\bcore\b|bottom ?line/, not: /serial|msn|top ?line|mpan top|supplementary/ },
+  { key: "meter_id", re: /\bmpxn\b|mpan mprn|mprn mpan|meter point|supply point|meter (number|no|ref|reference|id)$|^meter$|^meter (number|no|ref|reference|id)\b|spid/, not: /serial|msn|type|read|make|model|location|operator/ },
+
+  // Consumption
+  { key: "eac_night", re: /\bnight\b|off ?peak|\bnt\b|eac night|night (eac|kwh|units)/ },
+  { key: "eac_ewe", re: /\bewe\b|evening|weekend|eve wk|e w e/ },
+  { key: "eac_day", re: /\bday\b|\bpeak\b|eac day|day (eac|kwh|units)|\bstandard\b|single rate/, not: /days|date|today|payday/ },
+  { key: "aq", re: /^aq\b|\baq\b|annual quantity|gas (eac|kwh|consumption|usage|volume|annual|aq)/ },
+  { key: "elec_eac", re: /(elec|electricity|power) (eac|kwh|consumption|usage|volume|annual)/ },
+  { key: "eac", re: /\beac\b|annual (consumption|usage|kwh|volume)|estimated annual|consumption|usage|\bkwh\b|volume|\bload\b|\bsoq\b/, not: /cost|spend|price|rate|charge|£|standing|p kwh/ },
+
+  { key: "fuel", re: /^(fuel|utility|commodity|energy|energy type|fuel type|utility type|supply type|product type|service|type)$/ },
+
+  // Names and addresses
+  { key: "business_name", re: /business name|company name|customer name|client name|account name|legal (name|entity)|trading name|organi[sz]ation|tenant name|^(business|company|customer|client|account|tenant|entity|occupier|registered name|landlord)$/, not: /contact|number|no\b|ref|id$|email|phone/ },
+  { key: "site_name", re: /site name|property name|premises|^site$|^property$|^location$|building|site (description|ref|reference)|^unit$|^store$|^branch$/, not: /contact|email|phone/ },
+  { key: "address", re: /address|street|line ?1|^line 2|^town$|^city$|^county$|^locality$|^area$/, not: /email|invoice|billing|correspondence/, multi: true },
+];
+
+const TEMPLATE_HEADERS = new Set(["business name", "postcode", "crn", "mpan top line", "mpan core", "eac day", "eac night",
+  "eac ewe", "mprn 10 digit", "aq", "prefered start date dd mm yyyy", "prefered end date dd mm yyyy",
+  "preferred start date dd mm yyyy", "preferred end date dd mm yyyy"]);
+
+/** Match a header row. Returns { map: key→colIndex (address → [cols]), score, used }. */
+function mapHeader(header) {
+  const map = {}, used = new Set();
+  const texts = header.map(norm);
+  for (const rule of RULES) {
+    for (let i = 0; i < texts.length; i++) {
+      const t = texts[i];
+      if (!t || used.has(i) || t.length > 60) continue;
+      if (!rule.re.test(t) || (rule.not && rule.not.test(t))) continue;
+      if (rule.multi) { (map[rule.key] ||= []).push(i); used.add(i); continue; }
+      if (map[rule.key] != null) continue;
+      map[rule.key] = i; used.add(i);
+    }
+  }
+  const has = (k) => map[k] != null;
+  const meter = has("mpan_core") || has("mprn") || has("meter_id") || has("mpan_full");
+  const consumption = ["eac_day", "eac_night", "eac_ewe", "aq", "eac", "elec_eac"].some(has);
+  const score = Object.keys(map).length + (meter ? 3 : 0) + (consumption ? 1 : 0);
+  return { map, score, meter, used };
+}
+
+/** Find the header row in a sheet: the row (or pair of rows, for two-line headings) that matches best. */
+function findHeader(rows) {
+  let best = null;
+  const limit = Math.min(rows.length, 60);
+  for (let r = 0; r < limit; r++) {
+    const row = rows[r] || [];
+    const textCells = row.filter((v) => { const s = cellText(v); return s && !/^[\d\s.,/-]+$/.test(s); });
+    if (textCells.length < 2) continue;
+    const candidates = [{ header: row, at: r, span: 1 }];
+    if (r > 0 && (rows[r - 1] || []).some((v) => cellText(v))) {
+      const above = rows[r - 1];
+      const width = Math.max(row.length, above.length);
+      const joined = Array.from({ length: width }, (_, i) => `${cellText(above[i])} ${cellText(row[i])}`.trim());
+      candidates.push({ header: joined, at: r, span: 2 });
+    }
+    for (const c of candidates) {
+      const m = mapHeader(c.header);
+      if (!m.meter) continue;
+      if (!best || m.score > best.score) best = { ...c, ...m };
+    }
+  }
+  return best;
+}
+
+/** A name for the portfolio when the file has no business-name column. */
+function documentName(grids, filename) {
+  for (const g of grids) {
+    for (const row of g.rows.slice(0, 15)) {
+      for (let i = 0; i < row.length; i++) {
+        const t = cellText(row[i]);
+        const m = t.match(/^(customer|client|company|business|account|group|portfolio|landlord|organisation)(\s*name)?\s*[:\-]\s*(.+)$/i);
+        if (m && m[3].trim()) return { name: m[3].trim(), from: `"${t}" at the top of ${g.name}` };
+        if (/^(customer|client|company|business|account|group|portfolio)(\s*name)?\s*:?$/i.test(t)) {
+          const next = row.slice(i + 1).map(cellText).find(Boolean);
+          if (next) return { name: next, from: `"${t}" at the top of ${g.name}` };
+        }
+      }
+    }
+  }
+  const stem = String(filename || "").replace(/\.[^.]+$/, "")
+    .replace(/[_]+/g, " ")
+    .replace(/\b(summary|site ?list|sites?|meters?|portfolio|data|export|report|template|group|basket|quote|tender|final|copy|v\d+|\d{1,2}[.-]\d{1,2}[.-]\d{2,4})\b/gi, "")
+    .replace(/\s{2,}/g, " ").replace(/^[\s\-–()]+|[\s\-–()]+$/g, "").trim();
+  return stem ? { name: stem, from: `the file name "${filename}"` } : null;
+}
+
+const fuelOf = (v) => {
+  const s = norm(v);
+  if (/\bgas\b/.test(s)) return "GAS";
+  if (/elec|power|\bhh\b|\bnhh\b|\be\b/.test(s)) return "ELEC";
+  return null;
+};
+
+/* ------------------------------------------------------------------ conversion */
+
+/**
+ * @returns {{ rows, report }} rows are template-shaped (no `issues`, the caller checks them).
+ * report: { converted, sheets: [{ name, header_row, columns:[{from, to}] , ignored:[] }], assumptions:[], warnings:[] }
+ */
+export function convertGrids(grids, { filename = "" } = {}) {
+  const report = { converted: false, sheets: [], assumptions: [], warnings: [] };
+  const rows = [];
+  const docName = documentName(grids, filename);
+  let usedDocName = false, usedCurrentEnd = false, splitFull = false, lostPrecision = 0, builtTop = false;
+
+  for (const g of grids) {
+    const h = findHeader(g.rows);
+    if (!h) continue;
+    const { map } = h;
+    const labelOf = (i) => cellText(h.header[i]) || `Column ${i + 1}`;
+    const LABEL = { business_name: "Business Name", site_name: "(site name)", address: "(address → postcode)",
+      postcode: "Postcode", crn: "CRN", mpan_top: "MPAN Top Line", profile_class: "MPAN Top Line (PC)",
+      mtc: "MPAN Top Line (MTC)", llf: "MPAN Top Line (LLF)", mpan_core: "MPAN Core", mpan_full: "MPAN Top Line + Core",
+      mprn: "MPRN", meter_id: "MPAN Core / MPRN (by length)", eac_day: "EAC_DAY", eac_night: "EAC_NIGHT",
+      eac_ewe: "EAC_EWE", aq: "AQ", elec_eac: "EAC_DAY", eac: "EAC_DAY / AQ (by fuel)", fuel: "(fuel)",
+      start_date: "Preferred start date", end_date: "Preferred end date",
+      current_end: "Preferred start date (day after current end)", current_start: map.current_end == null ? "Preferred start date" : "(current contract start — not used)" };
+    const columns = [];
+    for (const [k, v] of Object.entries(map)) for (const i of [].concat(v)) columns.push({ from: labelOf(i), to: LABEL[k] || k, col: i });
+    columns.sort((a, b) => a.col - b.col);
+    const ignored = h.header.map((x, i) => (cellText(x) && !h.used.has(i) ? cellText(x) : null)).filter(Boolean);
+
+    const exactTemplate = h.at === 0 && h.span === 1
+      && h.header.filter((x) => cellText(x)).every((x) => TEMPLATE_HEADERS.has(norm(x)));
+    if (!exactTemplate) report.converted = true;
+    report.sheets.push({ name: g.name, header_row: h.at + 1, columns: columns.map(({ from, to }) => ({ from, to })), ignored });
+
+    const sheetFuel = /gas/i.test(g.name) && !/elec/i.test(g.name) ? "GAS" : /elec|power/i.test(g.name) && !/gas/i.test(g.name) ? "ELEC" : null;
+    const get = (cells, k) => (map[k] == null ? null : cells[map[k]]);
+    const headerKeys = new Set(h.header.map(norm).filter(Boolean));
+    let lastBusiness = "";
+
+    for (let r = h.at + 1; r < g.rows.length; r++) {
+      const cells = g.rows[r] || [];
+      const texts = cells.map(cellText);
+      if (!texts.some(Boolean)) continue;
+      const firstText = texts.find(Boolean) || "";
+      if (/^(sub ?)?totals?\b|^grand total|^total (eac|aq|kwh|consumption|sites)/i.test(firstText)) continue;
+      if (texts.filter(Boolean).length >= 2 && texts.filter(Boolean).every((t) => headerKeys.has(norm(t)))) continue; // repeated header
+
+      const row = {
+        row_no: r + 1, sheet: grids.length > 1 ? g.name : undefined,
+        business_name: cellText(get(cells, "business_name")),
+        postcode: "", crn: cellText(get(cells, "crn")),
+        mpan_top: "", mpan_core: "", eac_day: null, eac_night: null, eac_ewe: null,
+        mprn: "", aq: null, start_date: null, end_date: null,
+      };
+      // Business names are often written once and left blank for the sites below.
+      if (map.business_name != null) {
+        if (row.business_name) lastBusiness = row.business_name; else row.business_name = lastBusiness;
+      }
+      const site = cellText(get(cells, "site_name"));
+      const address = (map.address || []).map((i) => cellText(cells[i])).filter(Boolean).join(", ");
+      row.postcode = map.postcode != null ? normPostcode(get(cells, "postcode")) : "";
+      if (!row.postcode) row.postcode = findPostcode(address) || findPostcode(site);
+
+      // Fuel for this row: explicit column, else the sheet name, else worked out from the meter number.
+      const fuel = fuelOf(get(cells, "fuel")) || sheetFuel;
+
+      // Meter numbers.
+      const takeMpan = (v, isNumber) => {
+        const d = digits(v);
+        if (!d) return;
+        if (d.length >= 21) {
+          if (isNumber) { lostPrecision++; }
+          row.mpan_top = row.mpan_top || d.slice(0, d.length - 13);
+          row.mpan_core = d.slice(-13); splitFull = true;
+        } else row.mpan_core = d;
+      };
+      const isNum = (v) => typeof raw(v) === "number";
+      if (map.mpan_full != null) takeMpan(get(cells, "mpan_full"), isNum(get(cells, "mpan_full")));
+      if (map.mpan_core != null && !row.mpan_core) takeMpan(get(cells, "mpan_core"), isNum(get(cells, "mpan_core")));
+      if (map.mprn != null) row.mprn = digits(get(cells, "mprn"));
+      if (map.meter_id != null) {
+        const v = get(cells, "meter_id"), d = digits(v);
+        if (d) {
+          if (fuel === "GAS" || (!fuel && d.length >= 6 && d.length <= 11)) { if (!row.mprn) row.mprn = d; }
+          else if (!row.mpan_core) takeMpan(v, isNum(v));
+        }
+      }
+      if (map.mpan_top != null) {
+        const t = digits(get(cells, "mpan_top"));
+        if (t) row.mpan_top = t;
+      }
+      if (!row.mpan_top && (map.profile_class != null || map.mtc != null || map.llf != null)) {
+        const pc = digits(get(cells, "profile_class")), mtc = digits(get(cells, "mtc")), llf = digits(get(cells, "llf"));
+        if (pc || mtc || llf) { row.mpan_top = `${pc.padStart(2, "0")}${mtc.padStart(3, "0")}${llf.padStart(3, "0")}`; builtTop = true; }
+      }
+      // A row with a gas fuel type but a number in the MPAN column is really a gas meter.
+      if (fuel === "GAS" && row.mpan_core && !row.mprn && row.mpan_core.length <= 11) { row.mprn = row.mpan_core; row.mpan_core = ""; }
+
+      // Consumption.
+      row.eac_day = numOrNull(get(cells, "eac_day"));
+      row.eac_night = numOrNull(get(cells, "eac_night"));
+      row.eac_ewe = numOrNull(get(cells, "eac_ewe"));
+      row.aq = numOrNull(get(cells, "aq"));
+      const elecEac = numOrNull(get(cells, "elec_eac"));
+      if (row.eac_day == null && elecEac != null) row.eac_day = elecEac;
+      const generic = numOrNull(get(cells, "eac"));
+      if (generic != null) {
+        const isGas = fuel === "GAS" || (!fuel && row.mprn && !row.mpan_core);
+        if (isGas) { if (row.aq == null) row.aq = generic; }
+        else if (row.eac_day == null && row.eac_night == null && row.eac_ewe == null) row.eac_day = generic;
+      }
+
+      // Dates.
+      row.start_date = toIso(get(cells, "start_date"));
+      row.end_date = toIso(get(cells, "end_date"));
+      if (!row.start_date && map.current_end != null) {
+        const ced = toIso(get(cells, "current_end"));
+        if (ced) { row.start_date = addDays(ced, 1); usedCurrentEnd = true; }
+      }
+      // A lone "Start Date" with no end-date column is taken as the wanted start.
+      if (!row.start_date && map.current_end == null && map.current_start != null) {
+        row.start_date = toIso(get(cells, "current_start"));
+      }
+
+      const hasMeter = row.mpan_core || row.mprn;
+      if (!hasMeter && !row.business_name && !site) continue;            // notes, footers
+      if (!hasMeter && [row.eac_day, row.aq].every((x) => x == null) && !row.postcode) continue;
+
+      if (!row.business_name && docName) { row.business_name = docName.name; usedDocName = true; }
+      row._site = site || undefined;
+      rows.push(row);
+    }
+  }
+
+  if (usedDocName) report.assumptions.push(`No business-name column, so every site was given the name "${docName.name}" (taken from ${docName.from}). Edit the Business Name column in the converted template if that is wrong.`);
+  if (usedCurrentEnd) report.assumptions.push("Preferred start date was set to the day after each site's current contract end date.");
+  if (splitFull) report.assumptions.push("Full 21-digit MPANs were split into Top Line (first 8 digits) and Core (last 13).");
+  if (builtTop) report.assumptions.push("MPAN Top Line was built from the separate Profile Class, MTC and LLF columns.");
+  if (lostPrecision) report.warnings.push(`${lostPrecision} full MPAN(s) were stored as numbers in Excel, which drops digits beyond 15. Check those MPAN Cores, or format the column as Text in the source and re-upload.`);
+  if (report.sheets.length > 1) report.assumptions.push(`Sites were combined from ${report.sheets.length} sheets: ${report.sheets.map((s) => s.name).join(", ")}.`);
+  return { rows, report };
+}
+
+/* ------------------------------------------------------------------ writing the template */
+
+/** Fill the real supplier template with converted rows and return it as a Buffer. */
+export async function writeTemplate(templatePath, rows, { basket = false } = {}) {
+  const wb = new ExcelJS.Workbook();
+  await wb.xlsx.readFile(templatePath);
+  const ws = wb.worksheets[0];
+  const header = [];
+  ws.getRow(1).eachCell({ includeEmpty: true }, (c, i) => { header[i] = norm(c.value); });
+  const col = (re) => header.findIndex((h) => h && re.test(h));
+  const cols = {
+    business_name: col(/business name/), postcode: col(/post ?code/), crn: col(/^crn$/),
+    mpan_top: col(/mpan top/), mpan_core: col(/mpan core/), eac_day: col(/eac day/), eac_night: col(/eac night/),
+    eac_ewe: col(/eac ewe/), mprn: col(/mprn/), aq: col(/^aq$/), start_date: col(/start/), end_date: col(/end/),
+  };
+  // Keep the heading row's styling for the data; clear the sample rows.
+  const styleRow = ws.getRow(2);
+  const styles = {};
+  styleRow.eachCell({ includeEmpty: true }, (c, i) => { styles[i] = { ...c.style }; });
+  for (let r = ws.rowCount; r >= 2; r--) ws.spliceRows(r, 1);
+
+  const dmy = (iso) => (iso ? iso.split("-").reverse().join("/") : null);
+  const TEXT = new Set(["mpan_top", "mpan_core", "mprn", "crn"]);
+  rows.forEach((s, n) => {
+    const row = ws.getRow(n + 2);
+    for (const [k, i] of Object.entries(cols)) {
+      if (i < 1 || (k === "crn" && !basket)) continue;
+      let v = s[k];
+      if (k === "start_date" || k === "end_date") v = dmy(v);
+      if (v == null || v === "") continue;
+      const cell = row.getCell(i);
+      if (styles[i]) cell.style = { ...styles[i] };
+      cell.value = TEXT.has(k) ? String(v) : v;
+      if (TEXT.has(k) || k.endsWith("_date")) cell.numFmt = "@";
+    }
+    row.commit();
+  });
+  return Buffer.from(await wb.xlsx.writeBuffer());
+}
